from __future__ import annotations
import audioop
import wave
from pathlib import Path
from typing import Any, Dict


class VoiceActivityDetector:
    """Small dependency-free energy based VAD for mono PCM WAV files."""

    def analyze_wav(self, path: Path, threshold: int = 350, frame_ms: int = 30) -> Dict[str, Any]:
        with wave.open(str(path), "rb") as wav:
            channels = wav.getnchannels()
            width = wav.getsampwidth()
            rate = wav.getframerate()
            if channels != 1 or width != 2:
                return {"status": "unsupported", "reason": "WAV must be mono 16-bit PCM"}
            frames_per_chunk = max(1, int(rate * frame_ms / 1000))
            total = active = 0
            peak = 0
            while True:
                data = wav.readframes(frames_per_chunk)
                if not data:
                    break
                rms = audioop.rms(data, width)
                peak = max(peak, rms)
                total += 1
                if rms >= threshold:
                    active += 1
        ratio = active / total if total else 0.0
        return {
            "status": "ok",
            "speech_detected": active > 0,
            "active_ratio": round(ratio, 4),
            "active_frames": active,
            "total_frames": total,
            "peak_rms": peak,
            "threshold": threshold,
        }
