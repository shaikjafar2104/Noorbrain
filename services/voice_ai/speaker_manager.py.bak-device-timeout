from __future__ import annotations
from typing import Any, Dict


class SpeakerManager:
    def status(self) -> Dict[str, Any]:
        try:
            import sounddevice as sd  # type: ignore
            devices = sd.query_devices()
            outputs = [str(d.get("name", "unknown")) for d in devices if int(d.get("max_output_channels", 0)) > 0]
            return {"available": bool(outputs), "backend": "sounddevice", "output_devices": outputs}
        except Exception as exc:
            return {"available": False, "backend": None, "output_devices": [], "reason": str(exc)}
