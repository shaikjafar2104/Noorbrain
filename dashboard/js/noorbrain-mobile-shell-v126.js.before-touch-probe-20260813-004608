function logV126(tag, payload={}) {
  const entry = {
    tag,
    ts: Date.now(),
    ...payload
  };
  console.log("V126_" + tag, entry);
  return entry;
}

function directBridge(action) {
  const result = {
    action,
    bridge: null,
    route: null,
    ok: false
  };

  const openCamera = () => {
    const section = document.getElementById("nbv2CameraSection");
    if (section) {
      section.scrollIntoView({behavior: "smooth", block: "start"});
      result.route = "home";
      result.bridge = "legacy-camera-section";
      result.ok = true;
      return true;
    }
    if (window.NoorBrainDashboardCamera?.refresh) {
      window.NoorBrainDashboardCamera.refresh();
      result.bridge = "NoorBrainDashboardCamera.refresh";
      result.ok = true;
      return true;
    }
    return false;
  };

  const openActivity = () => {
    if (window.NoorBrainActivityIntelligence?.openPage) {
      window.NoorBrainActivityIntelligence.openPage();
      result.bridge = "NoorBrainActivityIntelligence.openPage";
      result.route = "activity";
      result.ok = true;
      return true;
    }
    const page = document.querySelector("[data-page='activity']");
    if (page) {
      page.click();
      result.bridge = "activity-page-click";
      result.route = "activity";
      result.ok = true;
      return true;
    }
    if (location && typeof location.href === "string") {
      location.href = "/studio#activity";
      result.bridge = "studio-activity";
      result.route = "activity";
      result.ok = true;
      return true;
    }
    return false;
  };

  switch (action) {
    case "halo":
      result.bridge = "navigate-halo";
      result.route = "halo";
      result.ok = true;
      navigate("halo");
      return result;

    case "devices":
      if (window.NoorMobileProductRouterV12?.open) {
        result.ok = !!window.NoorMobileProductRouterV12.open("devices");
        result.bridge = "NoorMobileProductRouterV12.open";
        result.route = "devices";
        return result;
      }
      result.bridge = "legacy-devices-section";
      result.route = "home";
      if (document.getElementById("nbv2Devices")) {
        document.getElementById("nbv2Devices").scrollIntoView({behavior: "smooth", block: "start"});
        result.ok = true;
      }
      return result;

    case "camera":
      result.route = "home";
      result.ok = openCamera();
      return result;

    case "automation":
      if (window.NoorAutomationCenterV12?.open) {
        window.NoorAutomationCenterV12.open("smart");
        result.bridge = "NoorAutomationCenterV12.open";
        result.route = "automation";
        result.ok = true;
        return result;
      }
      result.bridge = "navigate-automation";
      result.route = "automation";
      result.ok = true;
      navigate("automation");
      return result;

    case "automation-center":
    case "scenes":
    case "routines":
      if (window.NoorAutomationCenterV12?.open) {
        window.NoorAutomationCenterV12.open("smart");
        result.bridge = "NoorAutomationCenterV12.open";
        result.route = "automation";
        result.ok = true;
        return result;
      }
      navigate("automation");
      result.bridge = "navigate-automation";
      result.route = "automation";
      result.ok = true;
      return result;

    case "prayer":
      if (window.NoorMobileProductRouterV12?.open) {
        result.ok = !!window.NoorMobileProductRouterV12.open("prayer");
        result.bridge = "NoorMobileProductRouterV12.open";
        result.route = "islamic";
        return result;
      }
      location.href = "/studio#prayer-intelligence";
      result.bridge = "studio-prayer";
      result.route = "islamic";
      result.ok = true;
      return result;

    case "media":
      if (window.NoorMobileProductRouterV12?.open) {
        result.ok = !!window.NoorMobileProductRouterV12.open("media");
        result.bridge = "NoorMobileProductRouterV12.open";
        result.route = "islamic";
        return result;
      }
      location.href = "/studio#media-library";
      result.bridge = "studio-media";
      result.route = "islamic";
      result.ok = true;
      return result;

    case "islamic-rules":
      if (window.NoorIslamicRuleCreatorV12?.open) {
        window.NoorIslamicRuleCreatorV12.open();
        result.bridge = "NoorIslamicRuleCreatorV12.open";
        result.route = "islamic";
        result.ok = true;
        return result;
      }
      if (window.NoorMobileRulesV12?.open) {
        window.NoorMobileRulesV12.open();
        result.bridge = "NoorMobileRulesV12.open";
        result.route = "islamic";
        result.ok = true;
        return result;
      }
      location.href = "/studio#reminder-rules";
      result.bridge = "studio-islamic-rules";
      result.route = "islamic";
      result.ok = true;
      return result;

    case "zones":
      if (window.NoorMobileProductRouterV12?.open) {
        result.ok = !!window.NoorMobileProductRouterV12.open("zones");
        result.bridge = "NoorMobileProductRouterV12.open";
        result.route = "home";
        return result;
      }
      location.href = "/studio#vision-zones";
      result.bridge = "studio-zones";
      result.route = "home";
      result.ok = true;
      return result;

    case "voice":
      result.bridge = "navigate-halo";
      result.route = "halo";
      result.ok = true;
      navigate("halo");
      return result;

    case "activity":
      result.ok = openActivity();
      return result;

    case "settings":
      if (window.NoorMobileSettingsV11?.open) {
        window.NoorMobileSettingsV11.open();
        result.bridge = "NoorMobileSettingsV11.open";
        result.route = "more";
        result.ok = true;
        return result;
      }
      result.bridge = "navigate-more";
      result.route = "more";
      result.ok = true;
      navigate("more");
      return result;

    case "add-device":
      const addButton = document.getElementById("nbv2AddDevice");
      if (addButton) {
        addButton.click();
        result.bridge = "nbv2AddDevice.click";
        result.route = "home";
        result.ok = true;
        return result;
      }
      if (window.NoorMobileProductRouterV12?.open) {
        result.ok = !!window.NoorMobileProductRouterV12.open("devices");
        result.bridge = "NoorMobileProductRouterV12.open";
        result.route = "devices";
        return result;
      }
      location.href = "/studio#devices";
      result.bridge = "studio-devices";
      result.route = "home";
      result.ok = true;
      return result;

    default:
      result.bridge = "fallback-router";
      if (window.NoorMobileProductRouterV12?.open) {
        result.ok = !!window.NoorMobileProductRouterV12.open(action);
        result.route = action;
      }
      return result;
  }
}

function shell(){
  if($("noorbrainMobile126")) return;

  const root=document.createElement("div");
  root.id="noorbrainMobile126";

  root.innerHTML=`
    <header class="nb126-topbar">
      <div class="nb126-brand">
        <span class="nb126-logo">N</span>

        <div>
          <strong>NoorBrain</strong>
          <small id="nb126Connection">Home AI</small>
        </div>
      </div>

      <button
        type="button"
        class="nb126-top-action"
        data-nb126-action="notifications"
        aria-label="Notifications"
      >
        ♢
      </button>
    </header>

    <main id="nb126Content"></main>

    <nav
      class="nb126-bottom"
      aria-label="Main navigation"
    >
      ${Object.entries(TABS).map(([id,item])=>`
        <button
          type="button"
          data-nb126-route="${id}"
          class="${id==="home" ? "active" : ""}"
        >
          <span>${item.icon}</span>
          <small>${item.title}</small>
        </button>
      `).join("")}
    </nav>
  `;

  document.body.appendChild(root);

  root.addEventListener("click",event=>{
    const route=event.target.closest(
      "[data-nb126-route]"
    );

    if(route){
      console.log(
        "V126_CLICK",
        "route",
        route.dataset.nb126Route
      );
    }

    if(route){
      event.preventDefault();
      event.stopPropagation();
      event.stopImmediatePropagation();

      navigate(route.dataset.nb126Route);
      return;
    }

    const action=event.target.closest(
      "[data-nb126-action]"
    );

    if(action){
      console.log(
        "V126_CLICK",
        "action",
        action.dataset.nb126Action
      );
    }

    if(action){
      event.preventDefault();
      event.stopPropagation();
      event.stopImmediatePropagation();

      runAction(action.dataset.nb126Action);
    }
  }, true);

  navigate("home",false);
}

function navigate(name,push=true){
  console.log(
    "V126_NAVIGATE",
    name,
    "push=" + push
  );
  if(!renderers[name]) name="home";

  const content=$("nb126Content");
  if(!content) return;

  logV126("NAVIGATE", {route: name, push});
  content.innerHTML=renderers[name]();

  document.querySelectorAll(
    "#noorbrainMobile126 [data-nb126-route]"
  ).forEach(button=>{
    button.classList.toggle(
      "active",
      button.dataset.nb126Route===name
    );
  });

  document.body.dataset.nb126Page=name;

  if(push){
    history.pushState(
      {nb126:name},
      "",
      `#nb-${name}`
    );
  }

  content.scrollTop=0;
  window.scrollTo(0,0);
  logV126("RESULT", {route: name, visible: !!document.querySelector("#nb126Content")});
}

function runAction(action){
  console.log(
    "V126_ACTION",
    action
  );
  logV126("CLICK", {action});

  const result = directBridge(action);
  logV126("BRIDGE", result);

  if (result.ok) {
    logV126("RESULT", {action, route: result.route, bridge: result.bridge, ok: true});
    return true;
  }

  const fallback = window.NoorMobileProductRouterV12?.open?.(action);
  logV126("RESULT", {action, bridge: "NoorMobileProductRouterV12.open", ok: !!fallback, fallback});

  if (fallback) {
    return true;
  }

  if (window.NoorBrainUnifiedUI?.open) {
    const unified = window.NoorBrainUnifiedUI.open(action);
    logV126("RESULT", {action, bridge: "NoorBrainUnifiedUI.open", ok: !!unified, unified});
    if (unified) {
      return true;
    }
  }

  window.dispatchEvent(
    new CustomEvent(
      "noorbrain:v126-action",
      {detail:{action}}
    )
  );
  logV126("RESULT", {action, bridge: "custom-event", ok: true});
  return true;
}

window.addEventListener("popstate",event=>{
  navigate(
    event.state?.nb126 || "home",
    false
  );
});

window.NoorBrainMobile126={
  version:VERSION,
  navigate,
  action:runAction,
  mount:shell
};

