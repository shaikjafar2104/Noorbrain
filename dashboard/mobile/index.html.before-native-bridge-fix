<script id="noorbrain-native-mic-permanent-fix">
(() => {
  "use strict";

  const nativeApp = new URLSearchParams(location.search).get("native_app") === "1";
  if (!nativeApp) return;

  const button = document.getElementById("nbv2HaloMic");
  const reply = document.getElementById("nbv2HaloReply");
  if (!button) return;

  const plugins = window.Capacitor?.Plugins || {};
  const recorder = plugins.CapacitorAudioRecorder;
  const filesystem = plugins.Filesystem;

  // If the Capacitor bridge is unavailable, leave mobile-v2's browser fallback intact.
  if (!recorder) return;

  let recording = false;
  let busy = false;

  function message(text) {
    if (reply) reply.textContent = text;
  }

  function base64ToBlob(data, mimeType) {
    const clean = String(data || "").replace(/^data:[^,]+,/, "").replace(/\s+/g, "");
    const raw = atob(clean);
    const chunks = [];
    for (let offset = 0; offset < raw.length; offset += 32768) {
      const part = raw.slice(offset, offset + 32768);
      const bytes = new Uint8Array(part.length);
      for (let i = 0; i < part.length; i += 1) bytes[i] = part.charCodeAt(i);
      chunks.push(bytes);
    }
    return new Blob(chunks, {type: mimeType || "audio/mp4"});
  }

  async function recordingBlob(result) {
    if (result?.blob instanceof Blob) return result.blob;
    if (!result?.uri) throw new Error("Recorder did not return an audio file.");

    if (filesystem?.readFile) {
      const file = await filesystem.readFile({path: result.uri});
      if (file?.data) return base64ToBlob(file.data, "audio/mp4");
    }

    const response = await fetch(result.uri);
    if (!response.ok) throw new Error(`Cannot read recorded audio (${response.status}).`);
    return await response.blob();
  }

  async function transcribe(blob) {
    const form = new FormData();
    const type = blob.type || "audio/mp4";
    const ext = type.includes("webm") ? "webm" : type.includes("wav") ? "wav" : "m4a";
    form.append("audio", blob, `native-recording.${ext}`);

    const response = await fetch("/api/halo-voice/transcribe", {
      method: "POST",
      body: form,
      cache: "no-store",
    });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(payload.detail || `Voice HTTP ${response.status}`);
    return String(payload.command || payload.text || "").trim();
  }

  async function toggleNativeMic(event) {
    event.preventDefault();
    event.stopImmediatePropagation();
    if (busy) return;

    busy = true;
    try {
      if (!recording) {
        const permission = await recorder.requestPermissions();
        if (permission?.recordAudio !== "granted") throw new Error("Microphone permission denied.");
        await recorder.startRecording({sampleRate: 16000, bitRate: 64000});
        recording = true;
        button.textContent = "■ Stop";
        message("Listening… tap Stop when finished.");
        return;
      }

      message("Processing voice…");
      const result = await recorder.stopRecording();
      recording = false;
      button.textContent = "🎤 Push to Talk";
      const blob = await recordingBlob(result);
      const transcript = await transcribe(blob);
      if (!transcript) throw new Error("No speech detected.");

      document.getElementById("nbv2HaloInput").value = transcript;
      if (window.NoorBrainMobileV2?.sendHalo) {
        await window.NoorBrainMobileV2.sendHalo(transcript);
      } else {
        document.getElementById("nbv2HaloSend")?.click();
      }
    } catch (error) {
      recording = false;
      button.textContent = "🎤 Push to Talk";
      message(`Microphone error: ${error.message}`);
    } finally {
      busy = false;
    }
  }

  button.addEventListener("click", toggleNativeMic, true);
})();
</script>

