#noorbrainMobile126{
  --nb-bg:#080d18;
  --nb-card:#111827;
  --nb-card2:#172033;
  --nb-line:rgba(255,255,255,.08);
  --nb-text:#f8fafc;
  --nb-muted:#94a3b8;
  --nb-accent:#67e8f9;

  min-height:100vh;
  background:
    radial-gradient(
      circle at 50% -10%,
      rgba(45,212,191,.13),
      transparent 32%
    ),
    var(--nb-bg);

  color:var(--nb-text);
  padding-bottom:94px;
  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

.nb126-topbar{
  position:sticky;
  top:0;
  z-index:100;
  display:flex;
  align-items:center;
  justify-content:space-between;
  min-height:68px;
  padding:8px 18px;
  box-sizing:border-box;
  background:rgba(8,13,24,.88);
  border-bottom:1px solid var(--nb-line);
  backdrop-filter:blur(18px);
}

.nb126-brand{
  display:flex;
  align-items:center;
  gap:11px;
}

.nb126-brand strong,
.nb126-brand small{
  display:block;
}

.nb126-brand strong{
  font-size:16px;
}

.nb126-brand small{
  margin-top:2px;
  color:var(--nb-muted);
  font-size:11px;
}

.nb126-logo{
  display:grid;
  place-items:center;
  width:38px;
  height:38px;
  border-radius:13px;
  background:linear-gradient(
    145deg,
    #0f766e,
    #155e75
  );
  font-weight:900;
}

.nb126-top-action,
.nb126-profile{
  display:grid;
  place-items:center;
  border:1px solid var(--nb-line);
  background:var(--nb-card);
  color:#fff;
  cursor:pointer;
}

.nb126-top-action{
  width:40px;
  height:40px;
  border-radius:14px;
}

.nb126-profile{
  width:48px;
  height:48px;
  border-radius:50%;
  font-weight:800;
}

#nb126Content{
  width:min(760px,100%);
  margin:0 auto;
}

.nb126-hero,
.nb126-page-head{
  padding:28px 18px 12px;
}

.nb126-hero{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:18px;
}

.nb126-hero small,
.nb126-page-head small,
.nb126-halo-copy small{
  color:var(--nb-accent);
  font-size:10px;
  font-weight:800;
  letter-spacing:.14em;
}

.nb126-hero h1,
.nb126-page-head h1,
.nb126-halo h1{
  margin:5px 0 5px;
  font-size:28px;
  line-height:1.1;
}

.nb126-hero p,
.nb126-page-head p,
.nb126-halo p{
  margin:0;
  color:var(--nb-muted);
  line-height:1.45;
  font-size:13px;
}

.nb126-section{
  padding:12px 14px;
}

.nb126-section-title{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 4px 9px;
}

.nb126-section-title h2{
  margin:0;
  font-size:16px;
}

.nb126-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}

.nb126-tile{
  position:relative;
  display:flex;
  align-items:center;
  gap:11px;
  min-height:84px;
  padding:13px;
  box-sizing:border-box;
  border:1px solid var(--nb-line);
  border-radius:18px;
  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.035),
      transparent
    ),
    var(--nb-card);

  color:var(--nb-text);
  text-align:left;
  cursor:pointer;
}

.nb126-tile:active{
  transform:scale(.985);
}

.nb126-tile-icon{
  flex:0 0 auto;
  display:grid;
  place-items:center;
  width:42px;
  height:42px;
  border-radius:14px;
  background:var(--nb-card2);
  font-size:20px;
}

.nb126-tile-copy{
  min-width:0;
  flex:1;
}

.nb126-tile-copy strong,
.nb126-tile-copy small{
  display:block;
}

.nb126-tile-copy strong{
  font-size:14px;
}

.nb126-tile-copy small{
  margin-top:4px;
  color:var(--nb-muted);
  font-size:11px;
  line-height:1.3;
}

.nb126-chevron{
  color:#64748b;
  font-size:22px;
}

.nb126-badge{
  position:absolute;
  right:10px;
  top:9px;
  padding:3px 6px;
  border-radius:999px;
  font-size:9px;
  background:#134e4a;
}

.nb126-list{
  display:grid;
  gap:9px;
  padding:12px 14px;
}

.nb126-list .nb126-tile{
  min-height:72px;
}

.nb126-halo{
  display:flex;
  flex-direction:column;
  align-items:center;
  text-align:center;
  padding:35px 20px 20px;
}

.nb126-halo-copy{
  max-width:420px;
}

.nb126-orb{
  position:relative;
  display:grid;
  place-items:center;
  width:154px;
  height:154px;
  margin:38px 0 18px;
  border:0;
  border-radius:50%;
  background:
    radial-gradient(
      circle at 40% 35%,
      #67e8f9,
      #155e75 42%,
      #0f172a 72%
    );
  box-shadow:
    0 0 35px rgba(103,232,249,.18),
    0 0 80px rgba(20,184,166,.14);
  color:#fff;
  cursor:pointer;
}

.nb126-orb span{
  position:absolute;
  inset:-10px;
  border:1px solid rgba(103,232,249,.22);
  border-radius:50%;
}

.nb126-orb b{
  font-size:40px;
}

.nb126-halo-prompt{
  font-size:13px;
}

.nb126-bottom{
  position:fixed;
  left:50%;
  bottom:0;
  z-index:1000;
  transform:translateX(-50%);
  display:grid;
  grid-template-columns:repeat(5,1fr);
  width:min(760px,100%);
  min-height:72px;
  padding:
    6px
    max(8px,env(safe-area-inset-right))
    calc(6px + env(safe-area-inset-bottom))
    max(8px,env(safe-area-inset-left));

  box-sizing:border-box;
  background:rgba(8,13,24,.96);
  border-top:1px solid var(--nb-line);
  backdrop-filter:blur(18px);
}

.nb126-bottom button{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:4px;
  border:0;
  background:transparent;
  color:#64748b;
  cursor:pointer;
}

.nb126-bottom button span{
  font-size:20px;
}

.nb126-bottom button small{
  font-size:10px;
}

.nb126-bottom button.active{
  color:var(--nb-accent);
}

@media(max-width:420px){
  .nb126-grid{
    grid-template-columns:1fr 1fr;
    gap:8px;
  }

  .nb126-tile{
    min-height:96px;
    align-items:flex-start;
    flex-direction:column;
  }

  .nb126-chevron{
    display:none;
  }

  .nb126-hero h1,
  .nb126-page-head h1,
  .nb126-halo h1{
    font-size:25px;
  }
}

/* ===== V12.6-A2 SAFE MOUNT ===== */

body.noorbrain-v126-mounted{
  margin:0 !important;
  background:#080d18 !important;
  overflow-x:hidden;
}

/*
 * New shell always owns the visible phone viewport.
 * Legacy DOM/scripts remain available underneath
 * for later feature bridges.
 */
body.noorbrain-v126-mounted
> :not(#noorbrainMobile126):not(script):not(style):not(link){
  display:none !important;
}

body.noorbrain-v126-mounted
#noorbrainMobile126{
  display:block !important;
}


/*
 * V12.6 navigation ownership.
 * Keep legacy JS loaded for bridge compatibility,
 * but legacy visual shells/navs must never cover V12.6.
 */
body.noorbrain-v126-mounted .nbv2-nav,
body.noorbrain-v126-mounted .mobile-nav,
body.noorbrain-v126-mounted > .mobile-shell,
body.noorbrain-v126-mounted > .mobile-app,
body.noorbrain-v126-mounted > #mobileApp,
body.noorbrain-v126-mounted > #app {
  display: none !important;
  visibility: hidden !important;
  pointer-events: none !important;
}

body.noorbrain-v126-mounted #noorbrainMobile126 {
  display: block !important;
  visibility: visible !important;
  pointer-events: auto !important;
  position: relative;
  z-index: 1;
}

body.noorbrain-v126-mounted #noorbrainMobile126 .nb126-bottom {
  display: grid !important;
  visibility: visible !important;
  pointer-events: auto !important;
  z-index: 2147483000 !important;
}

body.noorbrain-v126-mounted #noorbrainMobile126 .nb126-bottom button,
body.noorbrain-v126-mounted #noorbrainMobile126 [data-nb126-route],
body.noorbrain-v126-mounted #noorbrainMobile126 [data-nb126-action] {
  pointer-events: auto !important;
  touch-action: manipulation;
}
