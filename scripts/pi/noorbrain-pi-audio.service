[Unit]
Description=NoorBrain Pi Audio Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=project
WorkingDirectory=/home/project/Projects/NoorCameraNode
ExecStart=/home/project/Projects/NoorCameraNode/run_pi_audio_node.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
