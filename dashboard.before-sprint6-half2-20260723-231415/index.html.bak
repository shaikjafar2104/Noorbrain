<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>NoorBrain AI Studio</title>
  <link rel="stylesheet" href="/dashboard-static/css/style.css?v=2">
</head>
<body>
  <aside class="sidebar">
    <div class="brand"><span class="brand-dot"></span><div><strong>NoorBrain</strong><small>AI Studio</small></div></div>
    <nav id="nav">
      <button class="nav-item active" data-page="dashboard">🏠 <span>Dashboard</span></button>
      <button class="nav-item" data-page="vision">🎥 <span>Vision</span></button>
      <button class="nav-item" data-page="people">👤 <span>People</span></button>
      <button class="nav-item" data-page="zones">🏡 <span>Zones</span></button>
      <button class="nav-item" data-page="timeline">📜 <span>Timeline</span></button>
      <button class="nav-item" data-page="halo">🤖 <span>HALO</span></button>
      <button class="nav-item" data-page="settings">⚙️ <span>Settings</span></button>
    </nav>
    <div class="sidebar-footer"><span id="backendDot" class="status-dot offline"></span><span id="backendText">Connecting…</span></div>
  </aside>

  <main class="main">
    <header class="topbar"><div><h1 id="pageTitle">Dashboard</h1><p id="pageSubtitle">Live NoorBrain overview</p></div><button id="refreshButton" class="secondary">↻ Refresh</button></header>

    <section id="page-dashboard" class="page active">
      <div class="cards">
        <article class="card"><span>Camera</span><strong id="camera">Disconnected</strong></article>
        <article class="card"><span>Persons</span><strong id="persons">0</strong></article>
        <article class="card"><span>Vision FPS</span><strong id="fps">0</strong></article>
        <article class="card"><span>Current Zone</span><strong id="currentZone">—</strong></article>
      </div>
      <div class="grid two">
        <article class="panel"><div class="panel-head"><h2>Live Vision</h2><span id="streamBadge" class="badge">Waiting</span></div><img class="stream" src="/vision_feed" alt="NoorBrain live vision"></article>
        <article class="panel"><div class="panel-head"><h2>Recent Events</h2><button class="link-button" data-open-page="timeline">View all</button></div><div id="dashboardEvents" class="timeline compact"></div></article>
      </div>
    </section>

    <section id="page-vision" class="page">
      <div class="toolbar"><button data-action="vision-start">▶ Start Vision</button><button data-action="vision-stop" class="danger">■ Stop Vision</button><button data-action="vision-restart" class="secondary">↻ Restart Vision</button><button data-action="camera-reconnect" class="secondary">Reconnect Camera</button></div>
      <article class="panel"><img class="stream large" src="/vision_feed" alt="Live vision"></article>
    </section>

    <section id="page-people" class="page">
      <article class="panel"><div class="panel-head"><h2>Live People</h2><span id="peopleCount" class="badge">0</span></div><div class="table-wrap"><table><thead><tr><th>ID</th><th>Zone</th><th>Confidence</th><th>Box</th></tr></thead><tbody id="peopleTable"></tbody></table></div></article>
    </section>

    <section id="page-zones" class="page"><article class="panel iframe-panel"><iframe src="/dashboard/zones" title="Zone editor"></iframe></article></section>

    <section id="page-timeline" class="page"><article class="panel"><div class="panel-head"><h2>Event Timeline</h2><button id="timelineRefresh" class="secondary">Refresh</button></div><div id="timeline" class="timeline"></div></article></section>

    <section id="page-halo" class="page">
      <article class="panel chat-panel"><div id="chatMessages" class="chat-messages"><div class="message halo">Assalamu Alaikum. HALO ready hai.</div></div><form id="haloForm" class="chat-form"><input id="haloInput" placeholder="Ask HALO anything…" autocomplete="off"><button type="submit">Send</button></form></article>
    </section>

    <section id="page-settings" class="page">
      <div class="grid two">
        <article class="panel"><h2>Vision Settings</h2><label>YOLO confidence: <strong id="confidenceValue">0.30</strong></label><input id="confidenceSlider" type="range" min="0.05" max="0.95" step="0.05" value="0.30"><button id="saveConfidence">Save Confidence</button></article>
        <article class="panel"><h2>System Information</h2><dl class="details"><dt>Camera URL</dt><dd id="settingCameraUrl">—</dd><dt>Model</dt><dd id="settingModel">—</dd><dt>Dashboard URL</dt><dd>/studio</dd></dl></article>
      </div>
    </section>

    <div id="toast" class="toast"></div>
  </main>
  <script src="/dashboard-static/js/app.js?v=2"></script>
</body>
</html>
