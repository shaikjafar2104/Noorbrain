<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Car-friendly dark theme with high contrast, large text -->
    <style name="Theme.CarConnect" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/car_primary</item>
        <item name="colorPrimaryVariant">@color/car_primary_variant</item>
        <item name="colorSecondary">@color/car_secondary</item>
        <item name="android:windowBackground">@color/car_dark_background</item>
        <item name="android:textColorPrimary">@color/car_on_background</item>
        <item name="android:textColorSecondary">@color/car_on_surface</item>
        <item name="colorOnPrimary">@color/car_on_primary</item>
    </style>

    <style name="Theme.CarConnect.NoActionBar" parent="Theme.CarConnect">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Large text for driving -->
    <style name="TextHeadingLarge" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineHeight">28sp</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <style name="TextBodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:lineHeight">24sp</item>
    </style>

    <style name="TextBodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight">20sp</item>
    </style>

    <style name="TextLog" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/log_text</item>
    </style>

    <!-- Large car-friendly button style -->
    <style name="Widget.CarConnect.Button" parent="Widget.Material3.Button">
        <item name="android:textSize">18sp</item>
        <item name="android:padding">16dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerSize">12dp</item>
    </style>
</resources>
