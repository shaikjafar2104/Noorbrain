#
# A generic POSIX sh script, capable of running bash, dash, or sh.
#

# Attempt to set APP_HOME
# Resolve links: top-up works because we never change directory
# away from the intended location (bin dir) before this script is invoked.

APP_HOME_SAVED="$(cd "\$(dirname -- "\$0")/" && pwd -P)"
APP_HOME="${APP_HOME_SAVED}/.."

# This path may be set, but not from the command line.
# If not set, use the default.
gradle_wrapper_jar="${APP_HOME}/gradle/wrapper/gradle-wrapper.jar"

# Set the JVM arguments, if applicable.
# This is needed for some JVMs to support the older protocol used by Gradle.
# You can also set this via the GRADLE_OPTS environment variable.
GRADLE_OPTS="-Xmx512m -Dfile.encoding=UTF-8 $GRADLE_OPTS"

# Use the Java from ANDROID_HOME or JAVA_HOME
if [ -n "$JAVA_HOME" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

exec "$JAVACMD" $JAVA_OPTS $GRADLE_OPTS -cp "$gradle_wrapper_jar" org.gradle.wrapper.GradleWrapperMain "$@"
